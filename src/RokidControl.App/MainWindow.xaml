<Window x:Class="RokidControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rokid Control"
        Height="600"
        Width="560"
        MinHeight="480"
        MinWidth="440"
        WindowStartupLocation="CenterScreen"
        Background="#0D1311"
        Foreground="White"
        UseLayoutRounding="True"
        Closing="Window_Closing">
    <Grid>
        <ScrollViewer x:Name="ModePanel"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel Margin="40,32"
                        VerticalAlignment="Center">
                <TextBlock Text="Rokid Control"
                           FontSize="30"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Text="Rokid AI Glasses RV101をWindowsから操作します"
                           Foreground="#B8C8C0"
                           FontSize="14"
                           Margin="0,8,0,28"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <Border Background="{StaticResource PanelBrush}"
                        CornerRadius="12"
                        Padding="18"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="背景を選んでください"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="ライブ映像はRokidのカメラ映像へ文字やアイコンを重ねます。背景なしは黒い背景で電池を節約します。"
                                   Foreground="#B8C8C0"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <Button x:Name="LiveButton"
                                Content="ライブ映像"
                                Click="LiveButton_Click"
                                Background="{StaticResource AccentBrush}"
                                Foreground="#07110C" />
                        <Button x:Name="StandardButton"
                                Content="背景なし（省電力）"
                                Click="StandardButton_Click" />
                    </StackPanel>
                </Border>
                <Button Content="キャンセル"
                        Click="CancelButton_Click"
                        HorizontalAlignment="Center"
                        Padding="22,8" />
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="ProgressPanel"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      Visibility="Collapsed">
            <StackPanel Margin="40,32"
                        VerticalAlignment="Center">
                <ProgressBar Height="5"
                             IsIndeterminate="True"
                             Foreground="{StaticResource AccentBrush}"
                             Margin="0,0,0,22" />
                <TextBlock x:Name="StatusText"
                           Text="Rokidを探しています…"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Text="接続には最大1分ほどかかる場合があります"
                           Foreground="#B8C8C0"
                           Margin="0,10,0,24"
                           HorizontalAlignment="Center" />
                <Button Content="キャンセル"
                        Click="CancelButton_Click"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="ErrorPanel"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      Visibility="Collapsed">
            <StackPanel Margin="40,32"
                        VerticalAlignment="Center">
                <TextBlock Text="開始できませんでした"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#FF8E8E"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorText"
                           Margin="0,14,0,20"
                           Foreground="#E4ECE8"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="もう一度試す"
                            Margin="0,6,8,6"
                            Click="RetryButton_Click" />
                    <Button Content="閉じる"
                            Click="CancelButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="LivePanel"
              Background="Black"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Image x:Name="LiveImage"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       SizeChanged="LiveImage_SizeChanged"
                       MouseLeftButtonDown="LiveImage_MouseLeftButtonDown"
                       MouseRightButtonDown="LiveImage_MouseRightButtonDown" />
                <Canvas x:Name="NavigationOverlay"
                        IsHitTestVisible="False">
                    <Ellipse x:Name="NavigationSelectionOuter"
                             Visibility="Collapsed"
                             Stroke="#A6000000"
                             StrokeThickness="7" />
                    <Ellipse x:Name="NavigationSelectionRing"
                             Visibility="Collapsed"
                             Stroke="#FF64D2FF"
                             StrokeThickness="3" />
                </Canvas>
            </Grid>
            <Border Grid.Row="1"
                    Background="#E617211D"
                    BorderBrush="#384C43"
                    BorderThickness="0,1,0,0"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="文字・アイコンの見やすさ"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <Slider x:Name="LiveVisibilitySlider"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="1"
                            Value="0.9"
                            TickFrequency="0.1"
                            ValueChanged="LiveVisibilitySlider_ValueChanged" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
