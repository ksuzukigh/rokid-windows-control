<Window x:Class="RokidControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:navigation="clr-namespace:RokidControl.Core.Navigation;assembly=RokidControl.Core"
        Title="Rokid Control"
        Icon="Resources/RokidControl.ico"
        Height="600"
        Width="560"
        MinHeight="480"
        MinWidth="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="#0D1311"
        Foreground="White"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing">
    <Grid>
        <ScrollViewer x:Name="ModePanel"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel Margin="40,32"
                        VerticalAlignment="Center">
                <TextBlock Text="Rokid Control"
                           FontSize="30"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Text="Rokid AI Glasses RV101をWindowsから操作します"
                           Foreground="#B8C8C0"
                           FontSize="14"
                           Margin="0,8,0,28"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <Border Background="{StaticResource PanelBrush}"
                        CornerRadius="12"
                        Padding="18"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="背景を選んでください"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="ライブ映像はRokidのカメラ映像へ文字やアイコンを重ねます。背景なしは黒い背景で電池を節約します。"
                                   Foreground="#B8C8C0"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <Button x:Name="LiveButton"
                                Content="ライブ映像"
                                Click="LiveButton_Click"
                                Background="{StaticResource AccentBrush}"
                                Foreground="#07110C" />
                        <Button x:Name="StandardButton"
                                Content="背景なし（省電力）"
                                Click="StandardButton_Click" />
                    </StackPanel>
                </Border>
                <Button x:Name="ProgressCancelButton"
                        Content="キャンセル"
                        Click="CancelButton_Click"
                        HorizontalAlignment="Center"
                        Padding="22,8" />
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="ProgressPanel"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      Visibility="Collapsed">
            <StackPanel Margin="40,32"
                        VerticalAlignment="Center">
                <ProgressBar Height="5"
                             IsIndeterminate="True"
                             Foreground="{StaticResource AccentBrush}"
                             Margin="0,0,0,22" />
                <TextBlock x:Name="StatusText"
                           Text="Rokidを探しています…"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Text="接続には最大1分ほどかかる場合があります"
                           Foreground="#B8C8C0"
                           Margin="0,10,0,24"
                           HorizontalAlignment="Center" />
                <Button Content="キャンセル"
                        Click="CancelButton_Click"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="ErrorPanel"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      Visibility="Collapsed">
            <StackPanel Margin="40,32"
                        VerticalAlignment="Center">
                <TextBlock Text="開始できませんでした"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#FF8E8E"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorText"
                           Margin="0,14,0,20"
                           Foreground="#E4ECE8"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="もう一度試す"
                            Margin="0,6,8,6"
                            Click="RetryButton_Click" />
                    <Button Content="閉じる"
                            Click="CancelButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="LivePanel"
              Background="Black"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Height="34"
                    Background="#F217211D"
                    BorderBrush="#384C43"
                    BorderThickness="0,0,0,1"
                    Padding="12,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="文字・アイコンの見やすさ"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1"
                               Text="薄い"
                               FontSize="11"
                               Foreground="#B8C8C0"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Slider x:Name="LiveVisibilitySlider"
                            Grid.Column="2"
                            MinWidth="80"
                            HorizontalAlignment="Stretch"
                            Minimum="0"
                            Maximum="1"
                            Value="0.9"
                            TickFrequency="0.1"
                            ToolTip="文字とアイコンの見やすさを調整します"
                            ValueChanged="LiveVisibilitySlider_ValueChanged" />
                    <TextBlock Grid.Column="3"
                               Text="濃い"
                               FontSize="11"
                               Foreground="#B8C8C0"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Image x:Name="LiveImage"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       MouseLeftButtonDown="LiveImage_MouseLeftButtonDown"
                       MouseRightButtonDown="LiveImage_MouseRightButtonDown" />
                <Border x:Name="KeyboardHint"
                        Visibility="Visible"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="12"
                        Padding="14,7"
                        CornerRadius="7"
                        Background="#E00D1311"
                        BorderBrush="#64D2FF"
                        BorderThickness="1"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="KeyboardHintText"
                               Text="{x:Static navigation:NavigationHintText.Normal}"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold" />
                </Border>
                <Border x:Name="LiveStatus"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="24"
                        Padding="16,10"
                        CornerRadius="7"
                        Background="#E00D1311"
                        BorderBrush="#6C8178"
                        BorderThickness="1"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="LiveStatusText"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
